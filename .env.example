# Absolute or relative path to your local factorio-benchmarks clone
FACTORIO_BENCHMARKS_PATH=../factorio/factorio-benchmarks

# YouTube Data API v3 key used by the homepage "Latest video" card.
# Restrict the key in the Google Cloud console to:
#   - API: YouTube Data API v3 only
#   - Application restriction: HTTP referrers = https://abucnasty.github.io/*
# The key is embedded in the client bundle; restriction is what keeps it safe.
VITE_YT_API_KEY=
